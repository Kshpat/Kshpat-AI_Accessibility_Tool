# ═══════════════════════════════════════════════════════════
#  MDM Screen Reader — Environment Configuration
#  Copy this file to .env and fill in your chosen provider key
# ═══════════════════════════════════════════════════════════

# ── CHOOSE YOUR AI PROVIDER ─────────────────────────────────
# Options: openrouter | groq | gemini
AI_PROVIDER=openrouter

# ── OPTION 1: OpenRouter (RECOMMENDED — Free, No Credit Card)
# Get free key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Free vision model (200 requests/day free):
OPENROUTER_MODEL=meta-llama/llama-3.2-11b-vision-instruct:free

# ── OPTION 2: Groq (Free, Very Fast)
# Get free key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# ── OPTION 3: Gemini (Free tier, may have quota issues)
# Get key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── NARRATION PROMPT (Optional — customize what AI focuses on)
NARRATION_PROMPT="You are looking at a computer screen. Provide a clear, natural-language description of the screen's content for a visually impaired person. Focus on crucial UI elements, readable text (OCR), layout, icons, open apps, and the current active task. Be concise but descriptive."
